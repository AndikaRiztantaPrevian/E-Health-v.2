<UserControl x:Class="UserControlDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:E_Health_Tugas_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="600">
    <Grid>

        <Button x:Name="CloseButton" Click="CloseButton_Click" Content="X" HorizontalAlignment="Left" Margin="545,10,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Candara Light" BorderThickness="0,0,0,0" Cursor="Hand" FontSize="30" Width="45" Height="45"/>

        <Grid>

            <Rectangle Fill="#FF2E797E" Margin="10,19,372,554">

                <Rectangle.Effect>

                    <DropShadowEffect BlurRadius="5" Opacity="1" ShadowDepth="2"/>

                </Rectangle.Effect>

            </Rectangle>

            <TextBlock Text="{Binding DateTimeNow}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Margin="30,25,0,0"/>

        </Grid>

        <Grid Width="600" Margin="0,50,0,10">

            <ItemsControl ItemsSource="{Binding Specialists}" Margin="0,10,0,0">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Grid Margin="10, 0">

                            <Rectangle Fill="#FF2E797E" HorizontalAlignment="Stretch" Height="100" Margin="0,15,0,0">

                                <Rectangle.Effect>

                                    <DropShadowEffect BlurRadius="5" Opacity="1" ShadowDepth="2"/>

                                </Rectangle.Effect>

                            </Rectangle>

                            <Button Command="{Binding DataContext.ItemClickedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand" />

                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Left" Margin="40,52,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold" Foreground="White"/>

                            <Ellipse Fill="{Binding StatusColor}" HorizontalAlignment="Left" Height="21" Margin="19,23,0,0" VerticalAlignment="Top" Width="21"/>

                            <TextBlock Text="{Binding TimeRange}" HorizontalAlignment="Left" Margin="50,26,0,0" VerticalAlignment="Top" Foreground="White"/>

                        </Grid>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

    </Grid>

</UserControl>
